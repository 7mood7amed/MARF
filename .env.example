# Copy to .env and fill in. Never commit .env.

# Leave empty to run in DEMO MODE (reads only the bundled sample invoices, no network calls).
ANTHROPIC_API_KEY=

# Model used to read invoices
MARF_MODEL=claude-sonnet-5-5

# Expected currency and VAT rate (Bahrain standard rate is 10%; check it is still current)
MARF_CURRENCY=BHD
MARF_VAT_RATE=0.10

# Where the database and uploaded files live
MARF_DATA_DIR=data

# Housekeeping
MARF_MAX_UPLOAD_MB=10
MARF_RETENTION_DAYS=90
MARF_SESSION_MINUTES=30
